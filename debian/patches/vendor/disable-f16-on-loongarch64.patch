Description: compiler_builtins: disable f16 builtins on loongarch64
 LLVM currently fails instruction selection for the f16 soft-float
 compiler_builtins on loongarch64, e.g. __truncsfhf2 triggers
 "Cannot select: f32 = fp16_to_fp". Keep f128 enabled, but do not emit
 the f16 conversion builtins for this target.
Forwarded: not-needed

Index: rustc-deepin/vendor/compiler_builtins-0.1.123/configure.rs
===================================================================
--- rustc-deepin.orig/vendor/compiler_builtins-0.1.123/configure.rs
+++ rustc-deepin/vendor/compiler_builtins-0.1.123/configure.rs
@@ -70,6 +70,8 @@ pub fn configure_f16_f128(target: &Targe
         "powerpc64" if &target.os == "aix" => (true, false),
         // `f128` crashes <https://github.com/llvm/llvm-project/issues/41838>
         "sparc" | "sparcv9" => (true, false),
+        // `f16` crashes during instruction selection for the soft-float builtins.
+        "loongarch64" => (false, true),
         // `f16` miscompiles <https://github.com/llvm/llvm-project/issues/96438>
         "wasm32" | "wasm64" => (false, true),
         // Most everything else works as of LLVM 19
